# FieldShift Backend Environment Variables
# Copy to .env and fill in values for production deployment

# API Configuration
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# Optional: External API Keys (if adding auth/paid services)
# NASA_POWER_API_KEY=
# USDA_SSURGO_API_KEY=

# Security
SECRET_KEY=change-this-to-a-secure-random-value